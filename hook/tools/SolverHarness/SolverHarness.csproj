<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SolverHarness: Spike 3.2's offline half.

    WHY IT COMPILES THE SOLVER'S SOURCE RATHER THAN REFERENCING THE HOOK'S DLL.

    The whole point of the exercise, IMPLEMENTATION-PLAN.md's words: that "the decision is
    a pure function of a plain-data snapshot ... so the solver can be tested without the game".
    A harness that referenced `Drelay.Bootstrap.dll` would drag the startup hook into the test
    process: that assembly's type initializers, its P/Invokes and its native shared block are all
    meaningful only inside the game. It would also make the offline result depend on which build
    of the hook happened to be on disk.

    A second, independent implementation of the solver in the harness (or in Python) would be
    worse: it would agree with the shipped solver until it did not, and the divergence would be
    invisible until a live run steered into a bullet.

    So the *same source files* are compiled into both places. `Compile Include` with a relative
    path is the only mechanism in MSBuild that guarantees that, and it also guarantees the
    harness cannot silently fall behind: a change to the solver that breaks the pure-data
    contract breaks this build immediately, which is exactly when you want to find out.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>SolverHarness</AssemblyName>
    <RootNamespace>Drelay.SolverHarness</RootNamespace>
    <UseAppHost>true</UseAppHost>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <!--
      WarningLevel is deliberately NOT inherited from managed/Directory.Build.props: this project
      lives under hook/tools, which that props file does not reach, and that is on purpose. The
      harness is not shipped into the game and should not be held to the hook's /WX bar for
      things like an unused local in a report function.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The pure-data contract and the solver. Nothing else from the hook may be added here: every
         file in this group is guaranteed to compile without the game. -->
    <Compile Include="..\..\managed\Drelay.Bootstrap\DodgeSnapshot.cs" Link="Solver\DodgeSnapshot.cs" />
    <Compile Include="..\..\managed\Drelay.Bootstrap\DodgeSolver.cs" Link="Solver\DodgeSolver.cs" />
    <!-- The frame's path (HANDOFF-DIRECTED-DODGE.md section 4). It is here for the same reason the
         other two are: it must compile with no game in sight, and a change that reaches for a game
         type has to break this build rather than the live one. -->
    <Compile Include="..\..\managed\Drelay.Bootstrap\PathPlanner.cs" Link="Solver\PathPlanner.cs" />
    <!-- The farmer's target selection (`PLAN-AUTOFARM.md` section 4). It is here for exactly the
         same reason as the three above: it must be a pure function of the snapshot, and a change
         that reaches for a game accessor has to break this build rather than the live one. The
         module's whole design point is that it publishes a goal point and touches nothing else,
         which is only checkable if it compiles with no game in sight. -->
    <Compile Include="..\..\managed\Drelay.Bootstrap\Farmer.cs" Link="Solver\Farmer.cs" />
    <!-- The lobby's portal reader, and the field-accessor builders it needs (`FieldAccessor`).
         The private farmer calls `PortalReader.TryActivate` from its lobby branch, so the harness
         cannot compile that module without this file. It is pure reflection with no game in sight,
         which is the same contract as the five around it: it resolves nothing until it is handed an
         assembly, and the harness never hands it one. -->
    <Compile Include="..\..\managed\Drelay.Bootstrap\PortalReader.cs" Link="Solver\PortalReader.cs" />
    <!-- The quest marker reader, on the same terms. The private farmer calls `QuestReader` from its
         quest branch, so the module cannot compile without it; and it is reflection-only, which is
         what lets the harness compile it with no game assembly in sight. `FieldLookup` is here for
         its `World.Quest`/`EventQuests` hierarchy walks. -->
    <Compile Include="..\..\managed\Drelay.Bootstrap\QuestReader.cs" Link="Solver\QuestReader.cs" />
    <Compile Include="..\..\managed\Drelay.Bootstrap\FieldAccessor.cs" Link="Solver\FieldAccessor.cs" />
    <Compile Include="..\..\managed\Drelay.Bootstrap\FieldLookup.cs" Link="Solver\FieldLookup.cs" />
    <!-- THE ROUTES (`PLAN-AUTOFARM.md` section 7). Same contract, same reason: the simplifier, the
         resampler, the snap, the deviation and the file format must all be pure functions of plain
         data, and a change that reaches for a game accessor has to break THIS build rather than the
         live one. `RouteRuntime.cs`, the part that reads the client, is deliberately NOT here, which
         is what keeps the split honest. -->
    <Compile Include="..\..\managed\Drelay.Bootstrap\Route.cs" Link="Solver\Route.cs" />
    <Compile Include="..\..\managed\Drelay.Bootstrap\RouteFollower.cs" Link="Solver\RouteFollower.cs" />
    <!-- THE DUNGEON (`PLAN-AUTOFARM.md` sections 8 and 14). Integers, a byte map and a queue, so
         it compiles here with no game in sight, and the `D1`..`D6` checks exercise the real classes
         rather than a copy of their rules: the whole question, whether a dungeon is mapped, a dead
         end spent and the boss reached, is answerable without the client. -->
    <Compile Include="..\..\managed\Drelay.Bootstrap\DungeonMap.cs" Link="Solver\DungeonMap.cs" />
    <Compile Include="..\..\managed\Drelay.Bootstrap\DungeonSolver.cs" Link="Solver\DungeonSolver.cs" />
  </ItemGroup>

  <!--
    THE PRIVATE FARM MODULE, ON THE SAME TERMS AS THE HOOK (`PLAN-AUTOFARM.md` section 13).

    `..\..\managed\Drelay.Bootstrap\Farmer.cs` above is the public stub. When `hook/private` holds
    sources they are compiled INSTEAD OF it, exactly as `Drelay.Bootstrap.csproj` does: the two
    project files have to agree or the harness would be measuring a different farmer from the one
    the hook ships. `Farmer.Installed` is how the harness knows which build it is running; the
    `farmer*` fixtures are skipped when it is false rather than failed, because a public checkout
    has not discovered a defect.

    The private sources are compiled here for the same reason the stub is: the module's whole
    design point is that it is a pure function of the snapshot, and that is only checkable if it
    compiles with no game in sight.
  -->
  <ItemGroup>
    <PrivateFarmSource Include="..\..\private\**\*.cs" />
  </ItemGroup>

  <PropertyGroup Condition="Exists('..\..\private')">
    <DefineConstants>$(DefineConstants);DRELAY_PRIVATE_FARMER</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('..\..\private')">
    <Compile Remove="..\..\managed\Drelay.Bootstrap\Farmer.cs" />
    <Compile Include="@(PrivateFarmSource)" LinkBase="Solver" />
  </ItemGroup>

</Project>
