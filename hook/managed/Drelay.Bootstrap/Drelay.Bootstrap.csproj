<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Drelay.Bootstrap: the startup hook.

    OutputType is Library because this is never executed. The host loads it into
    the game's process through DOTNET_STARTUP_HOOKS. It must NOT be published or
    self-contained, and it must not carry a runtimeconfig.json that the game's
    host could mistake for its own, so GenerateRuntimeConfigurationFiles is off.
  -->
  <PropertyGroup>
    <!--
      TARGET FRAMEWORK: net8.0, DELIBERATELY.

      The game runs .NET 9.0.20, so net9.0 looks like the obvious choice. The only
      SDK on this machine is 8.0.202, which refuses to target .NET 9 (NETSDK1045)
      and cannot fetch a newer one offline. That turns out not to matter, and the
      reason is worth recording so nobody "fixes" it:

        * the bootstrap is not an application. It is loaded into the game's
          process by the host, which is already running .NET 9, through
          DOTNET_STARTUP_HOOKS. A lower-TFM assembly in that role is not refused;
          TFM governs compilation against a reference surface and the host's
          runtime choice, and the host has already chosen;
        * nothing here needs a .NET 9 API. Reflection, Marshal/Unsafe, and
          UnmanagedCallersOnly with CallConvCdecl all exist in net8.0 and behave
          identically on the .NET 9 runtime.

      What this does cost is a guarantee, recorded as a known gap rather than
      glossed over: if the game ever ships a runtime older than this TFM, the
      startup hook will not load. That is caught loudly, not silently, the
      native side times out waiting for the bootstrap and says so in hook.log.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Drelay.Bootstrap</AssemblyName>
    <RootNamespace>Drelay.Bootstrap</RootNamespace>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- Never executed directly, so it needs no apphost. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <!--
    No reference to the native header, and no copy of it either. The managed view
    of the block lives in DrelayBlock.cs, and the two are kept in step by the
    attach-time checks (magic, version, struct size, and the explicit offsets
    re-derived by SharedLayout.VerifyOffsets) rather than by an include. A copy
    of the header here would be a third definition of the layout and would invite
    someone to trust it.
  -->

  <!--
    THE PRIVATE FARM MODULE (`PLAN-AUTOFARM.md` section 13).

    `Farmer.cs` beside this project file is the PUBLIC stub: the farmer's surface with no decision
    in it. The real module is `hook/private/Farmer.cs`, which is git-ignored and never published.
    When that directory is present the stub is removed and the private sources are compiled
    instead, so exactly one of the two defines `Drelay.Bootstrap.Farmer` in any build.

    WHY THE CONDITION IS `Exists` ON THE DIRECTORY AND NOT ON ONE FILE NAME: the private overlay
    may grow past one file (the state machine of section 5, the dungeon whitelist of section 8), and
    keying the swap on `Farmer.cs` would silently compile a second private file against a module
    that is not there. The directory is the switch and the glob collects whatever is in it.

    (MSBuild evaluates properties and items in separate passes, so a condition cannot test the item
    list itself: `'@(PrivateFarmSource)' != ''` is MSB4099 at project level. An empty `private`
    directory therefore removes the stub with nothing to replace it and fails to compile, which is
    the loud failure rather than the silent one.)

    `DRELAY_PRIVATE_FARMER` is defined for anything that has to compile differently. It is NOT how
    the code asks whether the farmer is installed: that is `Farmer.Installed`, a const, so no
    caller can be compiled against the other build's answer.
  -->
  <ItemGroup>
    <PrivateFarmSource Include="..\..\private\**\*.cs" />
  </ItemGroup>

  <PropertyGroup Condition="Exists('..\..\private')">
    <DefineConstants>$(DefineConstants);DRELAY_PRIVATE_FARMER</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('..\..\private')">
    <Compile Remove="Farmer.cs" />
    <Compile Include="@(PrivateFarmSource)" LinkBase="Private" />
  </ItemGroup>

</Project>
